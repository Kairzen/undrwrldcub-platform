// Cloudflare Workers static assets (platform baseline host). No Worker script: files only.
// Deploy: connect this repo in Cloudflare > Workers & Pages > Create > Import a repository
// (build command `npm run build`, deploy command `npx wrangler deploy`).
{
  "name": "SITE-NAME",
  "compatibility_date": "2026-09-01",
  // The site is served only from its custom domains: no SITE-NAME.<subdomain>.workers.dev duplicate.
  "workers_dev": false,
  // Preview URLs stay on for branch and PR builds (set explicitly: the default follows workers_dev).
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "SITE-NAME.undrwrldcub.com", "custom_domain": true }
  ],
  // Branch and PR builds run `npx wrangler preview`, which requires this block (it may stay empty).
  "previews": {}
}
